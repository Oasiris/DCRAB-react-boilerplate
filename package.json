{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "fmt": "prettier --write '**/*.ts' '**/*.tsx' '**/*.md' '**/*.json' '**/*.js' '!src/model/proto.js' '!lib/**/*'",
